{
  "name": "scost-portable-ai-chat",
  "version": "1.0.0",
  "format": "browser-global",
  "entrypoints": {
    "script": "src/AIChat.js",
    "style": "src/AIChat.css",
    "demoProvider": "src/demo-provider.js",
    "standaloneDemo": "demo/index.html"
  },
  "globalApi": "window.SCostAIChat",
  "requiredHostCapabilities": [
    "mount element",
    "trigger element",
    "context provider",
    "message provider"
  ],
  "optionalHostCapabilities": [
    "workspace persistence",
    "file attachment handler",
    "message action handler",
    "conflicting panel coordination",
    "open state analytics"
  ]
}
